# Shared native dependency target selection. Cross builds use a separate vendor root.
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set(CMAKE_OSX_DEPLOYMENT_TARGET "26.0" CACHE STRING "" FORCE)
    if(NOT CMAKE_OSX_ARCHITECTURES MATCHES "^(arm64|x86_64)$")
        message(FATAL_ERROR "Build one iOS architecture per artifact variant")
    endif()
    set(COVE_TRIPLE "ios-${CMAKE_OSX_ARCHITECTURES}")
    set(COVE_SPM_TRIPLE "${CMAKE_OSX_ARCHITECTURES}-apple-ios")
    if(CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
        string(APPEND COVE_TRIPLE "-simulator")
        string(APPEND COVE_SPM_TRIPLE "-simulator")
    endif()
    set(COVE_PLATFORM_CMAKE_ARGS -DCMAKE_SYSTEM_NAME=iOS
        -DCMAKE_OSX_SYSROOT=${CMAKE_OSX_SYSROOT}
        -DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}
        -DCMAKE_OSX_DEPLOYMENT_TARGET=26.0)
elseif(APPLE)
    set(COVE_MACOS_DEPLOYMENT_TARGET "26.0" CACHE STRING "Minimum macOS version")
    set(CMAKE_OSX_DEPLOYMENT_TARGET "${COVE_MACOS_DEPLOYMENT_TARGET}" CACHE STRING "" FORCE)
    set(COVE_PLATFORM_CMAKE_ARGS -DCMAKE_OSX_DEPLOYMENT_TARGET=${COVE_MACOS_DEPLOYMENT_TARGET})
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$" OR CMAKE_OSX_ARCHITECTURES MATCHES "arm64")
        set(COVE_TRIPLE "macos-arm64")
        set(COVE_SPM_TRIPLE "arm64-apple-macosx")
    else()
        set(COVE_TRIPLE "macos-x86_64")
        set(COVE_SPM_TRIPLE "x86_64-apple-macosx")
    endif()
elseif(ANDROID)
    if(NOT ANDROID_ABI MATCHES "^(arm64-v8a|x86_64)$")
        message(FATAL_ERROR "Unsupported Android ABI: ${ANDROID_ABI}")
    endif()
    if(ANDROID_ABI STREQUAL "arm64-v8a")
        set(COVE_TRIPLE "android-arm64")
        set(COVE_SPM_TRIPLE "aarch64-unknown-linux-android")
    else()
        set(COVE_TRIPLE "android-x86_64")
        set(COVE_SPM_TRIPLE "x86_64-unknown-linux-android")
    endif()
    set(COVE_PLATFORM_CMAKE_ARGS -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}
        -DANDROID_ABI=${ANDROID_ABI} -DANDROID_PLATFORM=${ANDROID_PLATFORM}
        -DANDROID_STL=${ANDROID_STL})
elseif(WIN32)
    set(COVE_PLATFORM_CMAKE_ARGS "")
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
        set(COVE_TRIPLE "windows-arm64")
        set(COVE_SPM_TRIPLE "aarch64-unknown-windows-msvc")
    else()
        set(COVE_TRIPLE "windows-x86_64")
        set(COVE_SPM_TRIPLE "x86_64-unknown-windows-msvc")
    endif()
elseif(UNIX)
    set(COVE_PLATFORM_CMAKE_ARGS "")
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
        set(COVE_TRIPLE "linux-aarch64")
        set(COVE_SPM_TRIPLE "aarch64-unknown-linux-gnu")
    else()
        set(COVE_TRIPLE "linux-x86_64")
        set(COVE_SPM_TRIPLE "x86_64-unknown-linux-gnu")
    endif()
else()
    message(FATAL_ERROR "Unsupported native target: ${CMAKE_SYSTEM_NAME}")
endif()
