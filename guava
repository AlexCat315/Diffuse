#!/bin/sh
set -eu
GUAVA_CHECKOUT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -z "${GUAVA_SDK_ROOT:-}" ]; then
  GUAVA_REQUIRED=$(sed -n 's/.*"sdkVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$GUAVA_CHECKOUT/Editor/guava.json")
  case "$(uname -s)" in
    Linux) GUAVA_INSTALLATION=${GUAVA_HOME:-"${XDG_DATA_HOME:-$HOME/.local/share}/guava"} ;;
    *) GUAVA_INSTALLATION=${GUAVA_HOME:-"$HOME/.guava"} ;;
  esac
  GUAVA_SELECTED=$(sed -n 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$GUAVA_INSTALLATION/sdk.json" 2>/dev/null | head -n 1)
  GUAVA_ACTUAL=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$GUAVA_SELECTED/Tools/Guava/Sources/GuavaCLI/SDK.json" 2>/dev/null | head -n 1)
  if [ "$GUAVA_ACTUAL" = "$GUAVA_REQUIRED" ]; then
    GUAVA_SDK_ROOT=$GUAVA_SELECTED
  else
    GUAVA_SDK_ROOT="$GUAVA_INSTALLATION/versions/$GUAVA_REQUIRED"
  fi
  if [ ! -f "$GUAVA_SDK_ROOT/Package.swift" ]; then
    guava sdk install "$GUAVA_REQUIRED"
  fi
fi
export GUAVA_SDK_ROOT
if [ "${1:-}" = studio ]; then
  shift
  GUAVA_RESULT=$(mktemp)
  trap 'rm -f "$GUAVA_RESULT"' EXIT HUP INT TERM
  "$GUAVA_SDK_ROOT/guava" internal build-package "$GUAVA_CHECKOUT/Tools/Developer" --product guava-dev --result-file "$GUAVA_RESULT" >&2
  GUAVA_PRODUCTS=$(sed -n 's/.*"products"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$GUAVA_RESULT")
  rm -f "$GUAVA_RESULT"
  GUAVA_ROOT="$GUAVA_CHECKOUT" exec "$GUAVA_PRODUCTS/guava-dev" "$@"
fi
exec "$GUAVA_SDK_ROOT/guava" "$@"
