package studio:swift-support;

interface capabilities {
  record language-server-input { request: string }
  language-server: func(input: language-server-input) -> string;
  /// One step of a package task: the request as JSON and the window of the
  /// previous command's standard output.
  record tasks-input { request: string, stdout: string }
  tasks: func(input: tasks-input) -> string;
  /// Shows a Package.resolved as the packages it pins.
  record view-input { view: string, state: string, event: string, context: string }
  view: func(input: view-input) -> string;
}

world plugin {
  import guava:process/host;
  export capabilities;
}
