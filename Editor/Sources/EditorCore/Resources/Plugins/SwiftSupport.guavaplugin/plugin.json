{
  "id": "studio.swift-support",
  "version": 2,
  "name": "Swift Support",
  "description": "Swift language service through SourceKit-LSP, and building, testing and running Swift packages.",
  "access": "read",
  "imports": [
    "guava:process/host"
  ],
  "composable_host_capabilities": [],
  "host": {
    "processes": [
      {
        "id": "language-server",
        "command": "sourcekit-lsp",
        "argumentPrefix": [],
        "allowsAdditionalArguments": true,
        "environmentKeys": [
          "PATH",
          "HOME",
          "TMPDIR",
          "TEMP",
          "TMP",
          "SystemRoot",
          "USERPROFILE",
          "DEVELOPER_DIR",
          "SDKROOT",
          "TOOLCHAINS",
          "SOURCEKIT_TOOLCHAIN_PATH",
          "SWIFT_EXEC",
          "SWIFTLY_BIN_DIR",
          "SWIFTLY_HOME_DIR",
          "SWIFTLY_TOOLCHAINS_DIR",
          "GUAVA_LOG_RUN_ID"
        ],
        "entryPoints": [
          "language-server"
        ],
        "lifetimeMilliseconds": null
      },
      {
        "id": "package",
        "command": "swift",
        "argumentPrefix": [],
        "allowsAdditionalArguments": true,
        "environmentKeys": [
          "PATH",
          "HOME",
          "TMPDIR",
          "TEMP",
          "TMP",
          "SystemRoot",
          "USERPROFILE",
          "DEVELOPER_DIR",
          "SDKROOT",
          "TOOLCHAINS",
          "SWIFT_EXEC",
          "SWIFTLY_BIN_DIR",
          "SWIFTLY_HOME_DIR",
          "SWIFTLY_TOOLCHAINS_DIR"
        ],
        "entryPoints": [
          "tasks"
        ],
        "lifetimeMilliseconds": null
      }
    ]
  },
  "contributes": {
    "guava.language/v1": [
      {
        "id": "swift",
        "title": "Swift",
        "extensions": [
          "swift"
        ],
        "server": {
          "process": "language-server",
          "initializationOptions": {
            "backgroundIndexing": true
          },
          "settings": {
            "sourcekit-lsp": {
              "backgroundIndexing": true
            }
          },
          "watchedFiles": [
            "Package.swift",
            "Package.resolved"
          ]
        }
      }
    ],
    "guava.tasks/v1": [
      {
        "id": "swiftpm",
        "title": "Swift Package",
        "marker": "Package.swift"
      }
    ]
  },
  "runtime": {
    "component": "component.wasm",
    "wit": "capabilities.wit",
    "compatibility": 1
  }
}
