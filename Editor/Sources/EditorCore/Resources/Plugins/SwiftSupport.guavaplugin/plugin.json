{
  "id": "studio.swift-support",
  "version": 1,
  "name": "Swift Support",
  "description": "Swift diagnostics, completion, hover and navigation through a host-managed SourceKit-LSP session.",
  "access": "read",
  "imports": ["guava:process/host"],
  "composable_host_capabilities": [],
  "host": {
    "processes": [{
      "id": "language-server",
      "command": "sourcekit-lsp",
      "argumentPrefix": [],
      "allowsAdditionalArguments": true,
      "environmentKeys": ["PATH", "HOME", "TMPDIR", "TEMP", "TMP", "SystemRoot", "USERPROFILE", "DEVELOPER_DIR", "SDKROOT", "TOOLCHAINS", "SOURCEKIT_TOOLCHAIN_PATH", "SWIFT_EXEC", "SWIFTLY_BIN_DIR", "SWIFTLY_HOME_DIR", "SWIFTLY_TOOLCHAINS_DIR", "GUAVA_LOG_RUN_ID"],
      "entryPoints": ["language-server"],
      "lifetimeMilliseconds": null
    }]
  }
}
