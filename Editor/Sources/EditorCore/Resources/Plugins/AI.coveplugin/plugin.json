{
  "id": "studio.ai",
  "version": 1,
  "name": "AI",
  "description": "Conversations, model adapters and assistant surfaces, implemented as a TypeScript plugin.",
  "access": "read",
  "imports": [
    "diffuse:editor/host",
    "cove:service/host"
  ],
  "composable_host_capabilities": [],
  "contributes": {
    "cove.ui.panel/v1": [
      {
        "id": "assistant",
        "title": "AI",
        "slot": "center",
        "icon": "ai-intent",
        "surface": "assistant",
        "entryPoint": "view"
      },
      {
        "id": "ai-conversations",
        "title": "会话",
        "slot": "leading",
        "inSurface": "studio.ai.assistant",
        "entryPoint": "view"
      },
      {
        "id": "ai-context",
        "title": "上下文",
        "slot": "trailing",
        "inSurface": "studio.ai.assistant",
        "entryPoint": "view"
      }
    ],
    "cove.extensionPoint/v1": [
      {
        "id": "studio.ai.providers/v1",
        "title": "Model Providers"
      },
      {
        "id": "studio.ai.tools/v1",
        "title": "Agent Tools"
      },
      {
        "id": "studio.ai.skills/v1",
        "title": "Agent Skills"
      }
    ],
    "cove.service/v1": [
      {
        "id": "diffuse.ai.conversation/v1",
        "title": "Current conversation",
        "entryPoint": "conversation"
      },
      {
        "id": "diffuse.ai.completion/v1",
        "title": "Text completion",
        "entryPoint": "complete"
      }
    ]
  },
  "runtime": {
    "engine": "bun",
    "entry": "plugin.js",
    "compatibility": 1
  },
  "activation": [
    "onStartup"
  ]
}
