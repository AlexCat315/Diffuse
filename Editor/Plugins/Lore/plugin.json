{
  "id": "studio.lore",
  "version": 1,
  "name": "Lore",
  "description": "Lore working trees and file locks for the Source Control panel, file tree, status bar and agent tools.",
  "access": "read",
  "imports": [
    "guava:process/host"
  ],
  "composable_host_capabilities": [],
  "host": {
    "processes": [
      {
        "id": "lore",
        "command": "lore",
        "argumentPrefix": [
          "--non-interactive",
          "--no-pager"
        ],
        "allowsAdditionalArguments": true,
        "environmentKeys": [
          "PATH",
          "HOME",
          "USER",
          "LOGNAME",
          "LANG",
          "LC_ALL",
          "TMPDIR",
          "XDG_CONFIG_HOME",
          "LORE_IDENTITY_TOKEN",
          "LORE_ACCESS_TOKEN",
          "SystemRoot",
          "USERPROFILE",
          "NO_COLOR"
        ],
        "entryPoints": [
          "provider"
        ],
        "lifetimeMilliseconds": 600000
      }
    ]
  },
  "contributes": {
    "guava.vcs/v1": [
      {
        "id": "lore",
        "title": "Lore",
        "marker": ".lore",
        "ignoreFile": ".loreignore",
        "priority": 1
      }
    ],
    "guava.ai.context/v1": [
      {
        "id": "lore",
        "title": "Lore Workspace",
        "entryPoint": "provider",
        "maxBytes": 4096
      }
    ]
  },
  "runtime": {
    "component": "component.wasm",
    "wit": "capabilities.wit",
    "compatibility": 1
  }
}
