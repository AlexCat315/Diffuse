{
  "id": "example.checklist",
  "version": 1,
  "name": "Checklist",
  "description": "A stateful checklist panel and a table view for CSV files, drawn from the plugin's component tree.",
  "access": "read",
  "imports": [],
  "composable_host_capabilities": [],
  "contributes": {
    "guava.ui.panel/v1": [
      {
        "id": "checklist",
        "title": "Checklist",
        "slot": "leading",
        "entryPoint": "view"
      }
    ],
    "guava.ui.documentView/v1": [
      {
        "id": "csv-table",
        "title": "Table",
        "extensions": ["csv"],
        "entryPoint": "view"
      }
    ]
  },
  "runtime": {
    "component": "component.wasm",
    "wit": "capabilities.wit",
    "compatibility": 1
  }
}
